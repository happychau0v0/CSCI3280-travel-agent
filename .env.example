# ── LLM provider ─────────────────────────────────────────────────────────────
# Option A: Google AI Studio (recommended — free tier, works globally, no TOS issues)
#   Get key: https://aistudio.google.com/apikey
LLM_PROVIDER=google
GOOGLE_AI_API_KEY=AI...
# LLM_MODEL=gemini-2.5-flash        # default when LLM_PROVIDER=google

# Option B: OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=x-ai/grok-4.20

# Google Maps Platform — single key for Places, Routes, Weather, Geocoding
# Enable: Places API (New), Routes API, Weather API, Geocoding API, Time Zone API
GOOGLE_MAPS_API_KEY=AIzaSy-...

# Optional: direct OpenAI key for Whisper STT / TTS upgrade
# OPENAI_API_KEY=sk-...

# Optional: proxy for OpenRouter LLM calls (needed when backend is outside the US
# and the primary model is geo-restricted, e.g. grok-4.20 is US-only).
# Clash mixed port: OPENROUTER_PROXY=http://127.0.0.1:7897
# OPENROUTER_PROXY=
