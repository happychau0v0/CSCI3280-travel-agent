# xAI direct API (OpenAI SDK compatible)
XAI_API_KEY=xai-...
LLM_MODEL=grok-4.20-0309-non-reasoning
# Other grok-4.20 variants:
#   grok-4.20-0309-reasoning          (slower, better multi-step reasoning)
#   grok-4.20-multi-agent-0309        (agentic tasks)

# Browser origins allowed to call the backend during local development.
# For a shared deployment, replace these with exact HTTPS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback LLM — used automatically when xAI is down (outage) or geo-restricted.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy-...
# FALLBACK_LLM_MODEL=gemini-3.1-pro-preview   # default; override if needed

# Google Maps Platform — single key for Places, Routes, Weather, Geocoding
# Enable: Places API (New), Routes API, Weather API, Geocoding API, Time Zone API
GOOGLE_MAPS_API_KEY=AIzaSy-...

# Optional score-tier fallbacks — Kimi K2-0905 and MiniMax M2.7.
# The service only calls OpenRouter through an explicit proxy, so set both
# values to enable these entries in the automatic fallback chain.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_PROXY=http://127.0.0.1:7897

# Optional proxy for other outbound API calls (xAI and Google Maps).
# HTTPS_PROXY=http://127.0.0.1:7897
