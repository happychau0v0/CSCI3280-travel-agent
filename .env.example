# xAI direct API (OpenAI SDK compatible)
XAI_API_KEY=xai-...
LLM_MODEL=grok-4.20-0309-non-reasoning
# Other grok-4.20 variants:
#   grok-4.20-0309-reasoning          (slower, better multi-step reasoning)
#   grok-4.20-multi-agent-0309        (agentic tasks)

# Fallback LLM — used automatically when xAI is down (outage) or geo-restricted.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy-...
# FALLBACK_LLM_MODEL=gemini-3.1-pro-preview   # default; override if needed

# Google Maps Platform — single key for Places, Routes, Weather, Geocoding
# Enable: Places API (New), Routes API, Weather API, Geocoding API, Time Zone API
GOOGLE_MAPS_API_KEY=AIzaSy-...

# Optional: direct OpenAI key for Whisper STT / TTS upgrade
# OPENAI_API_KEY=sk-...

# OpenRouter (not used by default — account banned; kept for reference)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_PROXY=
