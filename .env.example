# LLM via OpenRouter (OpenAI SDK compatible)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemini-3.1-flash-lite-preview
# Other options: openai/gpt-4.1-nano (dev), google/gemini-2.5-flash (balanced), google/gemini-2.5-pro (demo)

# Google Maps Platform — single key for Places, Routes, Weather, Geocoding
# Enable: Places API (New), Routes API, Weather API, Geocoding API, Time Zone API
GOOGLE_MAPS_API_KEY=AIzaSy-...

# Optional: direct OpenAI key for Whisper STT / TTS upgrade
# OPENAI_API_KEY=sk-...
